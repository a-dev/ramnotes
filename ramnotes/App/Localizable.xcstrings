    "Font size must be 8–192 points. Line spacing must be at least the font size and at most 384 points." : {
      "comment" : "Validation error under the typography fields",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون حجم الخط بين 8–192 نقطة. ويجب ألا يقل تباعد الأسطر عن حجم الخط وألا يزيد على 384 نقطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schriftgröße muss 8–192 Punkt betragen. Der Zeilenabstand muss mindestens der Schriftgröße entsprechen und darf höchstens 384 Punkt betragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño de letra debe estar entre 8 y 192 puntos. El interlineado debe ser como mínimo el tamaño de letra y como máximo 384 puntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille de police doit être comprise entre 8 et 192 points. L’interligne doit être au moins égal à la taille de police et au plus de 384 points."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォントサイズは8–192ポイントにしてください。行間はフォントサイズ以上、384ポイント以下にしてください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tamanho da fonte deve ser de 8–192 pontos. O espaçamento entre linhas deve ser de no mínimo o tamanho da fonte e no máximo 384 pontos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字体大小必须为8–192磅。行距不得小于字体大小，且不得超过384磅。"
          }
        }
      }
    },
