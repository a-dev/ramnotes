    "Scroll again to hide them. Use a trackpad or a mouse with precise scrolling." : {
      "comment" : "Settings explanation for the menu bar scroll gesture",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر مرة أخرى لإخفائها. استخدم لوحة تعقب أو ماوس يدعم التمرير الدقيق."
          }
        },
        "de" : {
          "stringUnit" : {
