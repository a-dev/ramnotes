          "stringUnit" : {
            "state" : "translated",
            "value" : "笔记或笔记文件夹不可用。"
          }
        }
      }
    },
    "The operation was cancelled." : {
      "comment" : "Error shown when the user or the system cancelled an operation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
