    "Shortcut registration failed (%d). Choose another shortcut. Manual reopen and Toggle Notes remain available." : {
      "comment" : "Settings: global shortcut failed and no shortcut is active; value is a system status code",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل تسجيل الاختصار (%d). اختر اختصارًا آخر. تظل إعادة الفتح اليدوية وإظهار/إخفاء الملاحظات متاحتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrierung des Kurzbefehls fehlgeschlagen (%d). Wählen Sie einen anderen Kurzbefehl. Manuelles erneutes Öffnen und „Notizen ein-/ausblenden“ bleiben verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error al registrar la función rápida (%d). Elige otra función rápida. La reapertura manual y Mostrar u ocultar notas siguen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l’enregistrement du raccourci (%d). Choisissez un autre raccourci. La réouverture manuelle et « Afficher/masquer les notes » restent disponibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを登録できませんでした（%d）。別のショートカットを選択してください。手動で開き直す操作と「メモの表示/非表示」は引き続き使用できます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao registrar o atalho (%d). Escolha outro atalho. A reabertura manual e Mostrar/Ocultar Notas continuam disponíveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快捷键注册失败（%d）。请选择其他快捷键。手动重新打开和“显示/隐藏笔记”仍可使用。"
          }
        }
      }
    },
    "Shortcut registration failed (%d). Still using %@. Choose another shortcut. Manual reopen and Toggle Notes remain available." : {
      "comment" : "Settings: global shortcut failed; first value is a system status code, second is the shortcut still in use",
      "localizations" : {
