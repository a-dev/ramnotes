          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر موقع الملاحظة. أعد المحاولة باستخدام موقعها الحالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicherort der Notiz hat sich geändert. Versuchen Sie es mit dem aktuellen Speicherort erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación de la nota ha cambiado. Reinténtalo con su ubicación actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’emplacement de la note a changé. Réessayez avec son emplacement actuel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモの場所が変更されました。現在の場所で再試行してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O local da nota mudou. Tente novamente com o local atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笔记位置已更改。请使用其当前位置重试。"
          }
        }
      }
    },
    "The note or notes folder is unavailable." : {
      "comment" : "Error when the note or its folder cannot be reached",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملاحظة أو مجلد الملاحظات غير متاح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notiz oder der Notizordner ist nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota o la carpeta de notas no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La note ou le dossier de notes est indisponible."
          }
        },
