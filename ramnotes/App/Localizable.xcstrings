    "Save failed: %@. A recovery copy is preserved." : {
      "comment" : "Shown in a note window when saving fails but a recovery journal exists. The value is the system error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل الحفظ: %@. تم الاحتفاظ بنسخة الاسترداد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern fehlgeschlagen: %@. Eine Wiederherstellungskopie wird aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error al guardar: %@. Se ha conservado una copia de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l’enregistrement : %@. Une copie de récupération est conservée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存に失敗しました：%@。復旧コピーが保持されています。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao salvar: %@. Uma cópia de recuperação foi preservada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储失败：%@。已保留恢复副本。"
          }
        }
      }
    },
    "Save failed: %@. Keep this window open. Saving retries automatically; export your text to keep a copy." : {
      "comment" : "Shown in a note window when saving fails and no recovery journal exists. The value is the system error",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل الحفظ: %@. أبقِ هذه النافذة مفتوحة. تتم إعادة محاولة الحفظ تلقائيًا؛ صدّر نصك للاحتفاظ بنسخة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern fehlgeschlagen: %@. Lassen Sie dieses Fenster geöffnet. Das Sichern wird automatisch wiederholt; exportieren Sie Ihren Text, um eine Kopie zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error al guardar: %@. Mantén esta ventana abierta. El guardado se reintenta automáticamente; exporta el texto para conservar una copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l’enregistrement : %@. Laissez cette fenêtre ouverte. L’enregistrement est réessayé automatiquement ; exportez votre texte pour en conserver une copie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存に失敗しました：%@。このウインドウを開いたままにしてください。保存は自動的に再試行されます。コピーを残すにはテキストを書き出してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao salvar: %@. Mantenha esta janela aberta. O salvamento será tentado novamente de forma automática; exporte o texto para manter uma cópia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储失败：%@。请保持此窗口打开。存储会自动重试；你可以导出文本以保留副本。"
          }
        }
      }
    },
