    "Your text is preserved separately. Open the recovery copy before continuing." : {
      "comment" : "Shown in a note window when its text was retained in a recovery journal",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الاحتفاظ بنصك بشكل منفصل. افتح نسخة الاسترداد قبل المتابعة."
