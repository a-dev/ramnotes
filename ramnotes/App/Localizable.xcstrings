    "A file already exists at the destination. Choose another name." : {
      "comment" : "Error when renaming or moving onto an existing file",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد ملف بالفعل في الوجهة. اختر اسمًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Zielort ist bereits eine Datei vorhanden. Wählen Sie einen anderen Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un archivo en el destino. Elige otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier existe déjà à cet emplacement. Choisissez un autre nom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動先に同じ名前のファイルがすでにあります。別の名前を選択してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe um arquivo no destino. Escolha outro nome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标位置已存在同名文件。请选择其他名称。"
          }
        }
      }
    },
    "A location operation needs reconciliation. Retry it before changing this note." : {
      "comment" : "Error when an unfinished move or rename blocks a new one",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج عملية الموقع إلى تسوية. أعد محاولتها قبل تغيير هذه الملاحظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Speicherortvorgang muss abgeglichen werden. Wiederholen Sie ihn, bevor Sie diese Notiz ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una operación de ubicación necesita conciliarse. Reinténtala antes de modificar esta nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une opération d’emplacement doit être résolue. Réessayez-la avant de modifier cette note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所の操作の整合処理が必要です。このメモを変更する前に再試行してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma operação de local precisa de reconciliação. Repita-a antes de alterar esta nota."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一项位置操作需要处理。请先重试该操作，再更改此笔记。"
          }
        }
      }
    },
    "A location operation needs retry or review." : {
      "comment" : "Reason shown for a note whose unfinished move or rename must be retried",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج عملية الموقع إلى إعادة المحاولة أو المراجعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
