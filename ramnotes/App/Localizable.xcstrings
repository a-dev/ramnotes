    "%@ Use Open Recovery." : {
      "comment" : "VoiceOver announcement. The first value is the visible warning. Open Recovery must match the translated button title",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ استخدم فتح الاسترداد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Verwenden Sie „Wiederherstellung öffnen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Usa Abrir recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Utilisez « Ouvrir la récupération »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 「復旧メモを開く」を使用してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Use Abrir Recuperação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请使用“打开恢复笔记”。"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "Line in the Add Existing Files results. First value is a file name, second is the system error\nLine in the Remove from List results. First value is a file name, second is the error\nOne Trash failure: file name, then the reason\nOne line in the move result: a file path, then the reason it was not moved. Both values are inserted as is",
