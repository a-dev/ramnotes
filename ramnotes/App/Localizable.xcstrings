    "The interrupted location operation lacks verified identity or revision evidence. Its record was preserved for review." : {
      "comment" : "Error when an unfinished move cannot be proven safe to resume",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفتقر عملية الموقع المتوقفة إلى دليل مُتحقق منه على الهوية أو المراجعة. تم الاحتفاظ بسجلها للمراجعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für den unterbrochenen Speicherortvorgang fehlen überprüfte Nachweise zu Identität oder Revision. Sein Eintrag wurde zur Prüfung aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La operación de ubicación interrumpida carece de pruebas verificadas de identidad o revisión. Su registro se ha conservado para su revisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opération d’emplacement interrompue ne dispose pas de preuve vérifiée d’identité ou de révision. Son enregistrement a été conservé pour vérification."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断された場所の操作には、検証済みの識別情報またはリビジョンの証拠がありません。確認のため記録は保持されました。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A operação de local interrompida não tem evidência verificada de identidade ou revisão. O registro foi preservado para revisão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断的位置操作缺少经过验证的身份或修订证据。其记录已保留以供检查。"
          }
        }
      }
    },
    "The location change was interrupted. Save again to retry the recorded operation." : {
      "comment" : "Error after an interrupted rename or Save As",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف تغيير الموقع. احفظ مرة أخرى لإعادة محاولة العملية المسجلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Änderung des Speicherorts wurde unterbrochen. Sichern Sie erneut, um den aufgezeichneten Vorgang zu wiederholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha interrumpido el cambio de ubicación. Vuelve a guardar para reintentar la operación registrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le changement d’emplacement a été interrompu. Enregistrez à nouveau pour réessayer l’opération enregistrée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所の変更が中断されました。記録された操作を再試行するには、もう一度保存してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A alteração de local foi interrompida. Salve novamente para repetir a operação registrada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置更改已中断。请再次存储以重试记录的操作。"
          }
        }
      }
    },
