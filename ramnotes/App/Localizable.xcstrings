    "Cannot close: %@. Your text remains here. Try again, or export it." : {
      "comment" : "Shown in a note window when closing fails. The value is the system error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الإغلاق: %@. يبقى نصك هنا. حاول مرة أخرى، أو قم بتصديره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen nicht möglich: %@. Ihr Text bleibt hier erhalten. Versuchen Sie es erneut oder exportieren Sie ihn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede cerrar: %@. Tu texto se mantiene aquí. Inténtalo de nuevo o expórtalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de fermer : %@. Votre texte reste ici. Réessayez ou exportez-le."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じられません：%@。テキストはここに残っています。もう一度試すか、書き出してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível fechar: %@. Seu texto permanece aqui. Tente novamente ou exporte-o."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法关闭：%@。你的文本仍保留在此处。请重试或将其导出。"
          }
        }
      }
    },
    "Cannot create note: %@" : {
      "comment" : "Shown when a new note cannot be created. The value is the system error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
