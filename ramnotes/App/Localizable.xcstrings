        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Text wird separat aufbewahrt. Öffnen Sie die Wiederherstellungskopie, bevor Sie fortfahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
