      }
    },
    "A notes folder is already active" : {
      "comment" : "Error when a notes folder is chosen while another is already open",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد مجلد ملاحظات نشط بالفعل"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Notizordner ist bereits aktiv"
          }
        },
        "es" : {
