    "The collection catalog is invalid or unsupported. Its original file was preserved." : {
      "comment" : "Error when the catalog file of tracked notes cannot be read",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرس المجموعة غير صالح أو غير مدعوم. تم الاحتفاظ بملفه الأصلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
