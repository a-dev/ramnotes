          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Vorgang wurde abgebrochen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha cancelado la operación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opération a été annulée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作はキャンセルされました。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A operação foi cancelada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作已取消。"
          }
        }
      }
    },
    "The original changed externally. Your local text is preserved in a recovery note." : {
      "comment" : "Shown in a note window when the original file changed on disk",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر الأصل خارجيًا. تم الاحتفاظ بنصك المحلي في ملاحظة استرداد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Original wurde extern geändert. Ihr lokaler Text wird in einer Wiederherstellungsnotiz aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El original se ha modificado externamente. Tu texto local se conserva en una nota de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’original a été modifié ailleurs. Votre texte local est conservé dans une note de récupération."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルが外部で変更されました。ローカルのテキストは復旧メモに保持されています。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O original foi alterado externamente. Seu texto local está preservado em uma nota de recuperação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始文件已在外部更改。你的本地文本已保留在恢复笔记中。"
          }
        }
      }
    },
    "The original file will be moved to Trash. You can restore it in Finder." : {
      "comment" : "Confirmation text before moving one note to the Trash. Use the system terms for Trash and Finder",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم نقل الملف الأصلي إلى سلة المهملات. يمكنك استعادته في Finder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Originaldatei wird in den Papierkorb gelegt. Sie können sie im Finder wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo original se trasladará a la Papelera. Puedes restaurarlo en Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier d’origine sera placé dans la corbeille. Vous pourrez le restaurer dans le Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルはゴミ箱に移動されます。Finderで戻すことができます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo original será movido para o Lixo. Você pode restaurá-lo no Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始文件将被移到废纸篓。你可以在访达中恢复。"
          }
        }
      }
    },
    "The original is missing. Your local text is preserved in a recovery note." : {
      "comment" : "Shown in a note window when the original file disappeared",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأصل مفقود. تم الاحتفاظ بنصك المحلي في ملاحظة استرداد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Original fehlt. Ihr lokaler Text wird in einer Wiederherstellungsnotiz aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el original. Tu texto local se conserva en una nota de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’original est introuvable. Votre texte local est conservé dans une note de récupération."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルが見つかりません。ローカルのテキストは復旧メモに保持されています。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O original não foi encontrado. Seu texto local está preservado em uma nota de recuperação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始文件丢失。你的本地文本已保留在恢复笔记中。"
          }
        }
      }
    },
    "The original is unavailable. Open its preserved text; RAMnotes reconnects when the folder returns." : {
      "comment" : "Note list message. Keep the product name RAMnotes unchanged.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأصل غير متاح. افتح النص المحفوظ الخاص به؛ يعيد RAMnotes الاتصال عند عودة المجلد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Original ist nicht verfügbar. Öffnen Sie den aufbewahrten Text; RAMnotes verbindet sich erneut, sobald der Ordner wieder verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El original no está disponible. Abre su texto conservado; RAMnotes se volverá a conectar cuando vuelva la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’original est indisponible. Ouvrez son texte conservé ; RAMnotes se reconnecte lorsque le dossier redevient disponible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルを使用できません。保持されたテキストを開いてください。フォルダが戻るとRAMnotesは再接続します。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O original está indisponível. Abra o texto preservado; o RAMnotes se reconecta quando a pasta voltar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始文件不可用。请打开其保留的文本；文件夹恢复后RAMnotes会重新连接。"
          }
        }
      }
    },
    "The original is unavailable. Open its preserved text. RAMnotes reconnects when the folder returns." : {
      "comment" : "Note list message. Keep the product name RAMnotes unchanged."
    },
    "The original note is at %@. This window keeps text loaded from the local recovery journal." : {
      "comment" : "Status text of the recovery viewer window. The value is the file path of the original note",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملاحظة الأصلية في %@. تحتفظ هذه النافذة بالنص المحمّل من سجل الاسترداد المحلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Originalnotiz befindet sich unter %@. Dieses Fenster enthält Text aus dem lokalen Wiederherstellungsprotokoll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota original está en %@. Esta ventana mantiene el texto cargado desde el registro de recuperación local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La note d’origine se trouve dans %@. Cette fenêtre conserve le texte chargé depuis le journal de récupération local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のメモは%@にあります。このウインドウには、ローカルの復旧ジャーナルから読み込んだテキストが保持されています。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nota original está em %@. Esta janela mantém o texto carregado do registro de recuperação local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始笔记位于 %@。此窗口保留从本地恢复日志载入的文本。"
          }
        }
      }
    },
    "The original note is at %@. This window keeps text loaded from the local recovery journal. %@" : {
      "comment" : "Status text of the recovery viewer window with an export result. First value is the file path of the original note, second is the export status sentence",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملاحظة الأصلية في %@. تحتفظ هذه النافذة بالنص المحمّل من سجل الاسترداد المحلي. %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Originalnotiz befindet sich unter %@. Dieses Fenster enthält Text aus dem lokalen Wiederherstellungsprotokoll. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota original está en %@. Esta ventana mantiene el texto cargado desde el registro de recuperación local. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La note d’origine se trouve dans %@. Cette fenêtre conserve le texte chargé depuis le journal de récupération local. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のメモは%@にあります。このウインドウには、ローカルの復旧ジャーナルから読み込んだテキストが保持されています。%@"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nota original está em %@. Esta janela mantém o texto carregado do registro de recuperação local. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始笔记位于 %@。此窗口保留从本地恢复日志载入的文本。%@"
          }
        }
      }
    },
    "The recovery journal directory cannot be the notes folder" : {
      "comment" : "Error when the user picks the recovery journal folder as the notes folder",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن أن يكون مجلد سجل الاسترداد هو مجلد الملاحظات"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner des Wiederherstellungsprotokolls kann nicht der Notizordner sein"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta del registro de recuperación no puede ser la carpeta de notas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier du journal de récupération ne peut pas servir de dossier de notes"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復旧ジャーナルのディレクトリをメモフォルダにすることはできません"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O diretório do registro de recuperação não pode ser a pasta de notas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复日志目录不能用作笔记文件夹"
          }
        }
      }
    },
    "The selected file is not the original file of this note. Select the original file to restore access." : {
      "comment" : "Error when Restore File Access receives a different file",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملف المحدد ليس الملف الأصلي لهذه الملاحظة. حدد الملف الأصلي لاستعادة الوصول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählte Datei ist nicht die Originaldatei dieser Notiz. Wählen Sie die Originaldatei, um den Zugriff wiederherzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo seleccionado no es el archivo original de esta nota. Selecciona el archivo original para restaurar el acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier sélectionné n’est pas le fichier d’origine de cette note. Sélectionnez le fichier d’origine pour rétablir l’accès."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したファイルはこのメモの元のファイルではありません。アクセスを復元するには、元のファイルを選択してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo selecionado não é o arquivo original desta nota. Selecione o arquivo original para restaurar o acesso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选文件不是此笔记的原始文件。请选择原始文件以恢复访问。"
          }
        }
      }
    },
    "The text that could not be saved will be lost. The file keeps its last saved text. To keep your text, use Export or Save a Copy instead." : {
      "comment" : "Message of the confirmation before closing a note whose text could not be saved",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُفقد النص الذي تعذّر حفظه. يحتفظ الملف بآخر نص محفوظ. للاحتفاظ بنصك، استخدم «تصدير» أو «حفظ نسخة» بدلاً من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text, der nicht gesichert werden konnte, geht verloren. Die Datei behält ihren zuletzt gesicherten Text. Verwende stattdessen „Exportieren“ oder „Kopie sichern“, um deinen Text zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perderá el texto que no se pudo guardar. El archivo conserva el último texto guardado. Para conservar tu texto, usa Exportar o Guardar una copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte qui n’a pas pu être enregistré sera perdu. Le fichier conserve son dernier texte enregistré. Pour garder votre texte, utilisez plutôt Exporter ou Enregistrer une copie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存できなかったテキストは失われます。ファイルには最後に保存したテキストが残ります。テキストを残すには、代わりに“書き出す”または“コピーを保存”を使用してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto que não pôde ser salvo será perdido. O arquivo mantém o último texto salvo. Para manter seu texto, use Exportar ou Salvar uma Cópia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法存储的文本将会丢失。文件会保留上次存储的文本。若要保留文本，请改用“导出”或“存储副本”。"
          }
        }
      }
    },
    "This file is already linked to another note. Choose a different file." : {
      "comment" : "Error when relinking a note to a file that another note already uses",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الملف مرتبط بالفعل بملاحظة أخرى. اختر ملفًا مختلفًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist bereits mit einer anderen Notiz verknüpft. Wählen Sie eine andere Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo ya está vinculado a otra nota. Elige otro archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier est déjà lié à une autre note. Choisissez un autre fichier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはすでに別のメモにリンクされています。別のファイルを選択してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo já está vinculado a outra nota. Escolha um arquivo diferente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件已链接到另一个笔记。请选择其他文件。"
          }
        }
      }
    },
    "This note is unavailable: %@. All your edits were saved before this happened." : {
      "comment" : "Shown in a note window when its storage becomes unavailable and no edit is waiting to be saved. The value is the system error"
    },
    "This note is unavailable. Locate the file, or wait for it to become available." : {
      "comment" : "Message in the Note location panel when no more specific reason is known",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الملاحظة غير متاحة. حدد موقع الملف، أو انتظر حتى يصبح متاحًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Notiz ist nicht verfügbar. Suchen Sie die Datei oder warten Sie, bis sie verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta nota no está disponible. Localiza el archivo o espera a que esté disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette note est indisponible. Localisez le fichier ou attendez qu’il redevienne disponible."
          }
        },
