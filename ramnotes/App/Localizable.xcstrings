    "Cannot export: %@. Your text remains here. Try again, or export it." : {
      "comment" : "Shown in a note window when exporting fails. The value is the system error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر التصدير: %@. يبقى نصك هنا. حاول مرة أخرى، أو قم بتصديره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportieren nicht möglich: %@. Ihr Text bleibt hier erhalten. Versuchen Sie es erneut oder exportieren Sie ihn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede exportar: %@. Tu texto se mantiene aquí. Inténtalo de nuevo o expórtalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
