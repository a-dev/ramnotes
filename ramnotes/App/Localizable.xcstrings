{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\nNotes with custom paths won’t be moved." : {
      "comment" : "Confirmation text for changing the default folder. The first line is the new folder path, then a line break, then the note about custom-path notes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nلن يتم نقل الملاحظات ذات المسارات المخصصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nNotizen mit eigenem Pfad werden nicht bewegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLas notas con rutas personalizadas no se trasladarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLes notes avec un chemin personnalisé ne seront pas déplacées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nカスタムパスのメモは移動されません。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nNotas com caminhos personalizados não serão movidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n使用自定义路径的笔记不会被移动。"
          }
        }
      }
    },
    "%@ (%@)" : {
