      }
    },
    "Cannot move to Trash: %@. Your text remains here. Try again, or export it." : {
      "comment" : "Shown in a note window when moving the note to the Trash fails. The value is the system error",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
